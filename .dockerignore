# ── Never include secrets ──────────────────────────────────────────────
.env
.env.*
*.key
*.pem

# ── Git ────────────────────────────────────────────────────────────────
.git/
.gitignore

# ── Node modules (installed fresh by npm ci in Dockerfile) ────────────
node_modules/
api/node_modules/
frontend/node_modules/

# ── Frontend source (static site deployed to GitHub Pages separately) ──
frontend/

# ── Python caches ──────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.Python
venv/
.venv/

# ── Vite build output ──────────────────────────────────────────────────
dist/
.vite/

# ── One-time dev/debug scripts ─────────────────────────────────────────
_step1_inventory.py
_check_names.py
_fix_names.py
_validate.py
_verify_phase2.py

# ── Generated CSVs (regenerated by cron in prod) ──────────────────────
data/statsbomb_player_stats.csv
data/nation_squad_scores.csv

# ── StatsBomb raw data (4+ GB — never ship in container) ──────────────
C:/statsbomb_raw/

# ── Docs / CI (not needed at runtime) ─────────────────────────────────
.github/
README.md
.railway/

# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
