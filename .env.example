# ══════════════════════════════════════════════════════════════════════
#  WC 2026 Predictor — Environment Variables Template
#
#  HOW TO USE:
#    cp .env.example .env
#    Fill in your actual values in .env
#    NEVER commit .env — it is in .gitignore
#
#  PRODUCTION (Railway):
#    Set these in Railway Dashboard → Project → Variables
#    See README.md section "Railway Environment Variables"
# ══════════════════════════════════════════════════════════════════════

# ── Required: API-Football (https://www.api-football.com/) ─────────────
# Free tier: 100 requests/day. Used by wc2026_data_pipeline.py
API_FOOTBALL_KEY=your_api_football_key_here

# ── Node.js server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database path ───────────────────────────────────────────────────────
# Local: leave empty (defaults to ./wc2026.db relative to project root)
# Railway: set to /app/wc2026.db
DB_PATH=

# ── Frontend (set this to your Railway backend URL after deploying) ──────
# Used during: cd frontend && npm run build
# Example: VITE_API_URL=https://your-project.up.railway.app
VITE_API_URL=http://localhost:3001
