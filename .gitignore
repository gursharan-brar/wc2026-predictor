# ══════════════════════════════════════════════════════════════════════
#  WC 2026 Predictor — .gitignore
#  SECURITY: .env must NEVER be committed. Verify with: git status
# ══════════════════════════════════════════════════════════════════════

# ── Secrets (NEVER commit) ─────────────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.*.local
*.key
*.pem
*.secret

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
.venv/
env/
ENV/
.python-version

# ── Node.js ────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ── Vite / React build output (rebuilt by CI for GitHub Pages) ─────────
frontend/dist/
frontend/.vite/
frontend/node_modules/

# ── Generated data files (large, regenerated by pipeline) ──────────────
# NOTE: wc2026.db, wc2026_model.pkl, simulation_results.json are
# intentionally COMMITTED so the Docker image has baseline data.
# They are updated in production by the daily cron job.
data/statsbomb_player_stats.csv
data/nation_squad_scores.csv

# ── One-time utility scripts (not needed in production) ────────────────
_step1_inventory.py
_check_names.py
_fix_names.py
_validate.py
_verify_phase2.py

# ── OS / Editor ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── Railway CLI ────────────────────────────────────────────────────────
.railway/

# ── Test / coverage ────────────────────────────────────────────────────
htmlcov/
.coverage
.pytest_cache/
dist/
build/
